# ---- Auth: pick ONE mode ----
# MODE A (recommended for personal use): bill against your Pro/Max subscription's
#   monthly Agent SDK credit (~$20/mo on Pro), NOT pay-as-you-go API credits.
#   1) Mint a subscription OAuth token with Claude Code:  claude setup-token
#   2) Provide it to the worker (verify exact var against current SDK docs):
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#   3) LEAVE ANTHROPIC_API_KEY UNSET. If it's set, it SILENTLY WINS and you'll
#      bill API credits while thinking you're on your subscription.
#
# MODE B (pay-as-you-go API key): uncomment to bill the Claude Platform per token.
# ANTHROPIC_API_KEY=sk-ant-...

VAULT_PATH=./vault                     # host path to your Obsidian vault (mounted at /vault)

# ---- Models (verify current IDs before wiring) ----
MODEL_TRIAGE=claude-haiku-4-5
MODEL_WORK=claude-sonnet-5
MODEL_ORCHESTRATOR=claude-opus-4-8
MODEL_HARD=claude-fable-5              # escalate per-leaf only

# ---- Caps (never run uncapped) ----
MAX_TURNS=12
MAX_OUTPUT_TOKENS=4096
RUN_TIMEOUT_SECONDS=600
# Per-run wall clock: a spent Claude usage limit (5-hr/weekly) or a stalled run is turned into a
# clear reply within this window instead of hanging until the 15-min stale-reaper.
INTERACTIVE_TIMEOUT_SECONDS=200

# Local timezone for scheduled work (morning brief 07:00, alerts 07:30, weekly review). Celery beat
# runs in UTC unless told otherwise — set this so the brief fires at 07:00 where you are, not 07:00 UTC.
TIMEZONE=UTC

# ---- Sub-agent fan-out (heavy parallel jobs; multiplies tokens — bounded) ----
SUBAGENTS_ENABLED=true
SUBAGENT_BUDGET_USD=2.5                 # hard $ cap on any run that may fan out
CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=1  # no nested sub-agents
CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=4

# ---- Infra ----
POSTGRES_USER=kioku
POSTGRES_PASSWORD=kioku
POSTGRES_DB=kioku
DATABASE_URL=postgresql://kioku:kioku@db:5432/kioku
REDIS_URL=redis://redis:6379/0

# ---- Front door ----
TELEGRAM_BOT_TOKEN=123:abc
TELEGRAM_ALLOWED_USER_ID=            # your numeric Telegram id — lock the bot to you only

# Web command center (Phase 2). A single shared secret gates the dashboard + API once the
# api service is exposed publicly on Railway. MUST be set before you expose the api. Leave
# empty ONLY while the service stays unexposed (internal-only). Generate a long random value.
DASHBOARD_TOKEN=
# With no token the API accepts only its own in-process Telegram bot (a random per-process secret).
# Set to 1 ONLY for a throwaway local stack; the CLI and runner need DASHBOARD_TOKEN otherwise.
ALLOW_UNAUTHENTICATED=0
# Telegram runs in-process. LEAVE THIS BLANK on Railway — it auto-derives http://localhost:$PORT.
# Only set it if the API listens on a fixed port (local compose binds 8000):
# API_BASE_URL=http://localhost:8000

# ---- Observability (Langfuse cloud free tier) ----
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0             # lower to stay under 50k units/mo as volume grows

# ---- Embeddings (retrieval semantic side) ----
# none  -> BM25-only (zero cost, still works). Fine to start.
# local -> sentence-transformers (NOT on Railway; use a VPS or a local-machine runner)
# openai/voyage -> hosted API (pennies; best fit for CPU-only Railway)
#
# TO TURN ON SEMANTIC + CROSS-LINGUAL RECALL LATER (whole vault ≈ $0.01 one-time):
#   1. set EMBEDDING_BACKEND=openai  and  EMBEDDING_API_KEY=sk-...   (on the WORKER service)
#   2. leave EMBEDDING_MODEL/DIM as below (text-embedding-3-small right-sized to 384 dims)
#   3. POST /reindex  (or wait for the nightly reindex) to embed everything once
# The code already handles it — if BACKEND=openai but MODEL is a local 'org/name' id, it
# falls back to text-embedding-3-small automatically, so step 1 alone is enough.
# ---- Opportunity radar (job scouting; boards searched via built-in WebSearch, no key) ----
JOB_BOARDS=wellfound.com,indeed.com,linkedin.com,remoteok.com
JOB_FIT_FLOOR=70

EMBEDDING_BACKEND=none
EMBEDDING_MODEL=text-embedding-3-small     # or voyage-3.5-lite, or the e5 model for local
EMBEDDING_DIM=384                          # MUST match vector(N) in schema.sql
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1

# ---- git-backed vault (portable truth on Railway; syncs to Obsidian devices) ----
VAULT_GIT_REMOTE=                          # https://x-access-token:<PAT>@github.com/you/vault.git
VAULT_GIT_BRANCH=main

# ---- Poller connector credentials (headless; not interactive OAuth) ----
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
VERCEL_TOKEN=
GITHUB_TOKEN=
GITHUB_REPOS=              # comma-separated owner/repo
# app DB — use a READ-ONLY role; SELECT-only is also enforced in code
APP_DB_URL=
APP_DB_QUERIES=           # signups:SELECT count(*) FROM users;active:SELECT count(*) FROM users WHERE last_seen > now()-interval '7 days'
# bank — READ-ONLY scope. Kioku issues GET only; no transfer code exists.
BANK_API_BASE=
BANK_TOKEN=
# ---- MCP tool connector tokens (match auth_env in connectors.yaml) ----
CALENDAR_MCP_TOKEN=
GMAIL_MCP_TOKEN=
DRIVE_MCP_TOKEN=
NOTION_MCP_TOKEN=
SHEETS_MCP_TOKEN=
CANVA_MCP_TOKEN=
FIGMA_MCP_TOKEN=
